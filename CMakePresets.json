  "buildPresets": [
    {
      "name": "otladka",
      "displayName": "Отладка (Ninja)",
      "configurePreset": "otladka"
    },
    {
      "name": "reliz",
      "displayName": "Релиз (Ninja)",
      "configurePreset": "reliz"
    },
    {
      "name": "tracy-debug",
      "displayName": "Tracy Debug (LENAppTracy)",
      "configurePreset": "tracy-debug",
      "configuration": "Debug",
      "targets": [
        "LENAppTracy"
      ]
    },
    {
      "name": "otladka-clang",
      "displayName": "Отладка (clang+Ninja)",
      "configurePreset": "otladka-clang"
    },
    {
      "name": "reliz-clang",
      "displayName": "Релиз (clang+Ninja)",
      "configurePreset": "reliz-clang"
    },
    {
      "name": "tracy-debug-clang",
      "displayName": "Tracy Debug (LENAppTracy, clang)",
      "configurePreset": "tracy-debug-clang",
      "configuration": "Debug",
      "targets": [
        "LENAppTracy"
      ]
    }
  ]
}
